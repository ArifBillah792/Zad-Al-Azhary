---
import type { Lang } from "../config/site";
import { t } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);

const icons: Record<string, string> = {
  exam: "M9 4h6M9 4a2 2 0 00-2 2v0H6a1 1 0 00-1 1v12a1 1 0 001 1h12a1 1 0 001-1V7a1 1 0 00-1-1h-1v0a2 2 0 00-2-2M9 4a2 2 0 012-0h2M8.5 12.5l2 2 4.5-4.5",
  tracker: "M4 5.5A1.5 1.5 0 015.5 4H11v16H5.5A1.5 1.5 0 014 18.5zM20 5.5A1.5 1.5 0 0018.5 4H13v16h5.5a1.5 1.5 0 001.5-1.5zM15.5 4v6l1.5-1.2 1.5 1.2V4",
  maps: "M12 9a3 3 0 100-6 3 3 0 000 6zM5 21a2.5 2.5 0 100-5 2.5 2.5 0 000 5zM19 21a2.5 2.5 0 100-5 2.5 2.5 0 000 5zM12 9v4M12 13l-5.5 3.5M12 13l5.5 3.5",
  color: "M12 3a9 9 0 100 18c1.1 0 1.5-.8 1.5-1.5 0-.9-.7-1.2-.7-2.1 0-.8.6-1.4 1.4-1.4H16a5 5 0 005-5c0-4.4-4-8-9-8zM7.5 11.5h.01M10 7.5h.01M15 7.5h.01",
};
---
<section class="overflow-hidden border-y border-white/5 bg-ink/40">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 md:grid-cols-[1fr_1.05fr] md:py-24">

    <!-- A page of the notes, showing the page tracker in the margin -->
    <figure class="relative mx-auto w-full max-w-sm" aria-hidden="true">
      <div class="absolute inset-0 translate-x-3 translate-y-3 rotate-2 rounded-lg bg-paper/30"></div>
      <div class="relative rounded-lg bg-paper p-6 text-[#1d2a3a] shadow-2xl" dir="rtl" lang="ar">
        <div class="flex items-center justify-between border-b-2 border-[#173a63] pb-2">
          <span class="naskh text-xl font-bold text-[#173a63]">النحو والصرف</span>
          <span class="naskh text-sm text-[#8a6a2b]">الباب الأول</span>
        </div>

        <div class="mt-4 flex items-start gap-3">
          <div class="flex-1">
            <p class="naskh text-lg font-bold text-[#6b2a3a]">تعريف الاسم</p>
            <p class="mt-1 rounded-md bg-[#dfe9f2] px-3 py-2 naskh leading-relaxed">كلمة دلّت على معنى في نفسها، ولم تقترن بزمان.</p>
          </div>
          <span class="mt-7 shrink-0 rounded-s-md bg-gold px-2 py-1 text-xs font-bold text-night ring-2 ring-gold/40" style="font-family:Cairo">ص 47</span>
        </div>

        <div class="mt-4">
          <p class="naskh text-lg font-bold text-[#2f6b52]">علاماته</p>
          <div class="mt-2 grid grid-cols-5 gap-1.5 text-center naskh text-sm">
            {["الجر", "التنوين", "النداء", "أل", "الإسناد"].map((w) => (
              <span class="rounded bg-[#e4efe8] py-1.5 text-[#17503a]">{w}</span>
            ))}
          </div>
        </div>

        <div class="mt-4 rounded-md border border-dashed border-[#8a6a2b]/60 bg-[#f7f0dd] p-3">
          <p class="text-xs font-bold text-[#8a6a2b]" style="font-family:Cairo">تدريب</p>
          <p class="naskh mt-1 text-sm">استخرج الأسماء من الآية، واذكر علامة كل منها.</p>
        </div>
      </div>
    </figure>

    <div>
      <h2 class="text-3xl font-extrabold sm:text-4xl">{d.features.title}</h2>
      <ul class="mt-8 grid gap-7 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
        {d.features.items.map((f) => (
          <li class="flex gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-gold/12 text-gold ring-1 ring-gold/25">
              <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={icons[f.key]} /></svg>
            </span>
            <div>
              <h3 class="text-lg font-bold">{f.title}</h3>
              <p class="mt-1 leading-relaxed text-muted">{f.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
