---
import Logo from "./Logo.astro";
import { contact, languages, type Lang } from "../config/site";
import { t, dictionaries } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<footer class="border-t border-white/5 bg-[#06101f]">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-12 sm:px-6 md:flex-row md:items-center">
    <div class="flex items-center gap-3">
      <Logo class="size-12" />
      <div>
        <p class="naskh text-2xl font-bold text-gold-soft">زاد الأزهري</p>
        <p class="text-sm text-muted">{d.footer.rights} {new Date().getFullYear()}</p>
      </div>
    </div>

    <div class="flex flex-wrap gap-3 md:ms-auto">
      <a href={contact.telegramGroup} target="_blank" rel="noopener" class="inline-flex h-10 items-center gap-2 rounded-lg border border-ink-2 px-4 text-sm hover:border-[#2aabee]">
        <svg viewBox="0 0 24 24" class="size-4 text-[#2aabee]" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3l-3.2 15.1c-.2 1.1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.3 13 1.5 11.5c-1-.3-1-1 .2-1.5L20.6 2.8c.9-.3 1.6.2 1.3 1.5z" /></svg>
        {d.footer.joinTelegram}
      </a>
      <a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener" dir="ltr" class="inline-flex h-10 items-center gap-2 rounded-lg border border-ink-2 px-4 text-sm hover:border-[#25d366]">
        <svg viewBox="0 0 24 24" class="size-4 text-[#25d366]" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2z" /></svg>
        +{contact.whatsapp.replace(/^(\d{2})(\d{3})(\d{3})(\d+)$/, "$1 $2 $3 $4")}
      </a>
    </div>

    <nav class="flex gap-4 text-sm text-muted" aria-label={d.nav.language}>
      {languages.map((l) => (
        <a href={`/${l}/`} lang={l} class:list={["hover:text-text", l === lang && "text-gold"]}>{dictionaries[l].langName}</a>
      ))}
    </nav>
  </div>
</footer>
