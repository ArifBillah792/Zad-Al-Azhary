---
import Logo from "./Logo.astro";
import { languages, type Lang } from "../config/site";
import { t, dictionaries } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const short: Record<Lang, string> = { ar: "ع", en: "EN", bn: "বাং", ms: "MS" };
---
<header class="sticky top-0 z-40 border-b border-white/5 bg-night/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a href={`/${lang}/`} class="flex items-center gap-3">
      <Logo class="size-10" />
      <span class="naskh text-xl font-bold leading-none text-gold-soft">زاد الأزهري</span>
    </a>

    <nav class="ms-auto hidden items-center gap-6 text-sm text-muted md:flex">
      <a href="#subjects" class="hover:text-text">{d.nav.subjects}</a>
      <a href="#group" class="hover:text-text">{d.nav.group}</a>
      <a href="#faq" class="hover:text-text">{d.nav.faq}</a>
    </nav>

    <details class="relative ms-auto md:ms-0">
      <summary
        class="flex h-9 cursor-pointer list-none items-center gap-1.5 rounded-lg border border-ink-2 px-3 text-sm text-text"
        aria-label={d.nav.language}
      >
        <svg viewBox="0 0 24 24" class="size-4 text-gold" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18" />
        </svg>
        {short[lang]}
      </summary>
      <ul class="absolute end-0 mt-2 w-44 overflow-hidden rounded-xl border border-ink-2 bg-ink py-1 shadow-xl">
        {languages.map((l) => (
          <li>
            <a
              href={`/${l}/`}
              lang={l}
              aria-current={l === lang ? "page" : undefined}
              class:list={[
                "block px-4 py-2 text-sm hover:bg-ink-2",
                l === lang ? "text-gold" : "text-text",
                l === "bn" && "font-bn",
              ]}
            >
              {dictionaries[l].langName}
            </a>
          </li>
        ))}
      </ul>
    </details>

    <a href="#order" class="hidden h-9 items-center rounded-lg bg-gold px-4 text-sm font-bold text-night hover:bg-gold-soft sm:inline-flex">
      {d.nav.order}
    </a>
  </div>
</header>
