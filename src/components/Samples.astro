---
// Sample PDFs, one per subject.
// Put each file in /public/samples/ named by subject id:
//   nahw.pdf  mantiq.pdf  sunnah.pdf  fiqh.pdf  nuzum.pdf  quran.pdf
// Optional cover thumbnail with the same name: nahw.jpg, mantiq.jpg, ...
// A missing PDF shows a "coming soon" card instead.
import fs from "node:fs";
import path from "node:path";
import { subjects, type Lang } from "../config/site";
import { t, fill } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);

const dir = path.join(process.cwd(), "public", "samples");
const items = subjects.map((s) => {
  const pdf = path.join(dir, `${s.id}.pdf`);
  const hasPdf = fs.existsSync(pdf);
  const mb = hasPdf ? fs.statSync(pdf).size / 1048576 : 0;
  return {
    ...s,
    hasPdf,
    hasCover: fs.existsSync(path.join(dir, `${s.id}.jpg`)),
    size: hasPdf ? (mb < 1 ? `${Math.max(1, Math.round(mb * 1024))} KB` : `${mb.toFixed(1)} MB`) : "",
  };
});
---
<section id="samples" class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 md:pb-24">
  <div class="max-w-2xl">
    <h2 class="text-3xl font-extrabold sm:text-4xl">{d.samples.title}</h2>
    <p class="mt-3 text-lg text-muted">{d.samples.lead}</p>
  </div>

  <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3">
    {items.map((s) => {
      const name = d.subjects.names[s.id];
      const cover = (
        <div class="relative aspect-[3/4] w-full overflow-hidden rounded-lg md:aspect-[4/3]">
          {s.hasCover ? (
            <img src={`/samples/${s.id}.jpg`} alt={fill(d.samples.alt, { subject: name })} loading="lazy" class="h-full w-full object-cover" />
          ) : (
            <div class="flex h-full w-full flex-col items-center justify-center gap-3 p-4 text-center" style={`background:${s.color};box-shadow:inset 0 0 0 1px rgba(233,214,166,.25)`}>
              <span class="h-px w-10 bg-gold/70"></span>
              <span class="naskh text-xl font-bold leading-snug text-gold-soft sm:text-2xl" lang="ar" dir="rtl">{s.arabic}</span>
              <span class="h-px w-10 bg-gold/70"></span>
            </div>
          )}
          <span class="absolute start-2 top-2 rounded-full bg-night/80 px-2.5 py-0.5 text-xs font-bold text-gold">{d.samples.badge}</span>
          {!s.hasPdf && <span class="absolute inset-0 bg-night/55"></span>}
        </div>
      );
      return (
        <li class="flex flex-col rounded-2xl border border-ink-2 bg-ink p-2.5 sm:p-3">
          {s.hasPdf ? (
            <a href={`/samples/${s.id}.pdf`} target="_blank" rel="noopener" class="block focus-visible:outline-2" aria-label={`${d.samples.open}: ${name}`}>{cover}</a>
          ) : cover}
          <div class="mt-3 flex flex-1 flex-col px-1">
            <span class="font-bold leading-snug">{name}</span>
            {s.hasPdf ? (
              <>
                <span class="mt-0.5 text-xs text-muted">PDF · {s.size}</span>
                <a href={`/samples/${s.id}.pdf`} target="_blank" rel="noopener" class="mt-3 inline-flex items-center justify-center gap-2 rounded-xl bg-gold px-3 py-2.5 text-sm font-bold text-night hover:brightness-110">
                  <svg viewBox="0 0 20 20" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 4.5c2.5-1 4.8-.8 7 .8 2.2-1.6 4.5-1.8 7-.8v11c-2.5-1-4.8-.8-7 .8-2.2-1.6-4.5-1.8-7-.8z" /><path d="M10 5.3v11" /></svg>
                  {d.samples.open}
                </a>
              </>
            ) : (
              <span class="mt-3 rounded-xl border border-dashed border-ink-2 px-3 py-2.5 text-center text-sm text-muted">{d.samples.soon}</span>
            )}
          </div>
        </li>
      );
    })}
  </ul>

  <p class="mt-4 text-sm text-muted">{d.samples.note}</p>
</section>