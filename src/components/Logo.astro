---
// Placeholder roundel. To use your real logo, put it in /public/logo.png
// and replace this whole SVG with: <img src="/logo.png" alt="Zad Al-Azhari" class={cls} />
interface Props { class?: string }
const { class: cls = "size-11" } = Astro.props;
---
<svg viewBox="0 0 64 64" class={cls} role="img" aria-label="Zad Al-Azhari">
  <circle cx="32" cy="32" r="31" fill="#0e2340" stroke="#d3ad5c" stroke-width="1.5" />
  <g fill="none" stroke="#d3ad5c" stroke-opacity=".55" stroke-width="1">
    <rect x="14" y="14" width="36" height="36" />
    <rect x="14" y="14" width="36" height="36" transform="rotate(45 32 32)" />
  </g>
  <text x="32" y="38" text-anchor="middle" font-family="Amiri, serif" font-size="15" font-weight="700" fill="#e9d6a6">زاد</text>
</svg>
